// ps3gl fragment program: GL_ADD
void main(
    float4 col : COLOR0,
    float4 tc  : TEXCOORD0,
    float4 fog : TEXCOORD1,
    float4 env : TEXCOORD2,
    uniform sampler2D tex : TEXUNIT0,
    out float4 oc : COLOR)
{
    float4 t = tex2D(tex, tc.xy);
    float4 c = float4(col.rgb + t.rgb, col.a * t.a);
    oc = float4(lerp(fog.rgb, c.rgb, fog.a), c.a);
}
