--- plib-1.8.4/src/ssg/ssgLoadTexture.cxx	2003-06-27 10:15:15.000000000 +0200
+++ plib-1.8.4.ps3/src/ssg/ssgLoadTexture.cxx	2026-10-04 14:25:40.617835375 +0200
@@ -276,8 +276,39 @@
 
 
 
+#ifdef __PS3__
+/* Textures of models made on Windows are often referred to in a different
+   case than the file has; look for the file ignoring case. */
+static bool ssgFindFileNoCase ( const char *filename, char *found, int len )
+{
+  const char *slash = strrchr ( filename, '/' ) ;
+  char dir [ 1024 ] ;
+  bool ok = false ;
+  if ( slash == NULL || slash - filename >= (int) sizeof(dir) ) return false ;
+  memcpy ( dir, filename, slash - filename ) ;
+  dir [ slash - filename ] = '\0' ;
+  ulDir *d = ulOpenDir ( dir ) ;
+  if ( d == NULL ) return false ;
+  ulDirEnt *e ;
+  while ( ! ok && ( e = ulReadDir ( d ) ) != NULL )
+    if ( ulStrEqual ( e -> d_name, slash + 1 ) )
+    {
+      snprintf ( found, len, "%s/%s", dir, e -> d_name ) ;
+      ok = true ;
+    }
+  ulCloseDir ( d ) ;
+  return ok ;
+}
+#endif
+
 bool ssgLoadTexture ( const char * filename, ssgTextureInfo* info )
 {
+#ifdef __PS3__
+  char found [ 1024 ] ;
+  if ( filename != NULL && *filename != '\0' && ! ulFileExists ( filename ) &&
+       ssgFindFileNoCase ( filename, found, sizeof(found) ) )
+    filename = found ;
+#endif
   if ( info != NULL )
   {
     info -> width = 0 ;
