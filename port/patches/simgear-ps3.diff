+struct TileTimer {      // building time of sgBinObjLoad, for the PS3 port's log
+    struct timeval t0;
+    TileTimer(const struct timeval &t) : t0(t) {}
+    ~TileTimer() {
+        struct timeval t1;
+        gettimeofday(&t1, 0);
+        unsigned long long us = (t1.tv_sec - t0.tv_sec) * 1000000ULL + t1.tv_usec - t0.tv_usec;
