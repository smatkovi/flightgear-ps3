+++ SimGear-0.3.10.ps3/simgear/structure/event_mgr.cxx	2026-10-04 14:38:16.589973247 +0200
@@ -77,7 +77,17 @@
 void SGTimerQueue::update(double deltaSecs)
 {
     _now += deltaSecs;
+#ifdef __PS3__
+    // Run each timer that was due when this update started at most about
+    // once. A timer that reschedules itself with no delay (settimer(f, 0),
+    // aircraft.light with interval 0 - common in aircraft made for later
+    // FlightGear versions) then runs again next frame, as it does there,
+    // instead of looping here forever.
+    int budget = _numEntries;
+    while(budget-- > 0 && _numEntries && nextTime() <= _now) {
+#else
     while(_numEntries && nextTime() <= _now) {
+#endif
         SGTimer* t = remove();
         t->run();
     }
