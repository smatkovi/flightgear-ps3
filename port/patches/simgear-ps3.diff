diff -ruN '--exclude=*.orig' '--exclude=*.rej' SimGear-0.3.10/simgear/nasal/misc.c SimGear-0.3.10.ps3/simgear/nasal/misc.c
--- SimGear-0.3.10/simgear/nasal/misc.c	2005-09-26 21:56:49.000000000 +0200
+++ SimGear-0.3.10.ps3/simgear/nasal/misc.c	2026-10-04 15:01:08.874060039 +0200
@@ -214,3 +214,12 @@
 int naIsCode(naRef r)   { return IS_CODE(r); }
 int naIsCCode(naRef r)  { return IS_CCODE(r); }
 int naIsGhost(naRef r)  { return IS_GHOST(r); }
+
+// Number of parameters (required and optional) a Nasal function or code
+// object declares; -1 for anything else.
+int naNumParams(naRef r)
+{
+    if(IS_FUNC(r)) r = r.ref.ptr.func->code;
+    if(!IS_CODE(r)) return -1;
+    return r.ref.ptr.code->nArgs + r.ref.ptr.code->nOptArgs;
+}
